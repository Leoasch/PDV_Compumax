@inject ServicoAtalhos ServicoAtalhos
@implements IDisposable

<MudDialog>
    <TitleContent>Finalizar venda</TitleContent>
    <DialogContent>
        <MudText Typo="Typo.subtitle2">Total a pagar</MudText>
        <MudText Typo="Typo.h4" Class="mb-4">@Subtotal.ToString("C2")</MudText>

        <MudText Typo="Typo.subtitle2" Class="mb-2">Forma de pagamento</MudText>
        <div class="opcoes-forma-pagamento mb-4">
            <MudRadioGroup T="FormaPagamento" @bind-Value="_formaPagamento" @bind-Value:after="AtualizarAtalhoValorRecebido">
                @foreach (var opcao in _opcoesFormaPagamento)
                {
                    <MudRadio T="FormaPagamento" Value="@opcao.Forma" Color="Color.Primary" Class="opcao-forma-pagamento">
                        <div class="d-flex justify-space-between align-center opcao-forma-pagamento-conteudo">
                            <span>@opcao.Forma.ObterLabel()</span>
                            <Atalho Tecla="@opcao.Tecla" />
                        </div>
                    </MudRadio>
                }
            </MudRadioGroup>
        </div>

        @if (_formaPagamento == FormaPagamento.Dinheiro)
        {
            <MudNumericField T="decimal" @ref="_campoValorRecebido" @bind-Value="_valorRecebido" Label="Valor recebido" Min="0" Format="F2" Class="mb-2" />
            <Atalho Tecla="F5" Descricao="Informar valor recebido" />
            <MudText Typo="Typo.subtitle2">Troco: @Troco.ToString("C2")</MudText>

            @if (_valorRecebido < Subtotal)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">Valor recebido é menor que o total.</MudAlert>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton StartIcon="@Icons.Material.Filled.Check" Color="Color.Primary" Variant="Variant.Filled" Disabled="@(!PodeConfirmar)" OnClick="Confirmar">
            Concluir venda <Atalho Tecla="Enter" />
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public decimal Subtotal { get; set; }

    private readonly List<IDisposable> _atalhos = [];
    private IDisposable? _atalhoFocarValorRecebido;
    private MudNumericField<decimal> _campoValorRecebido = default!;

    private readonly List<(FormaPagamento Forma, string Tecla)> _opcoesFormaPagamento =
    [
        (FormaPagamento.Dinheiro, "F1"),
        (FormaPagamento.CartaoCredito, "F2"),
        (FormaPagamento.CartaoDebito, "F3"),
        (FormaPagamento.Pix, "F4"),
    ];

    private FormaPagamento _formaPagamento = FormaPagamento.Dinheiro;
    private decimal _valorRecebido;
    private bool _valorInicializado;
    private bool _deveFocarValorRecebido;

    private decimal Troco => _formaPagamento == FormaPagamento.Dinheiro ? Math.Max(0, _valorRecebido - Subtotal) : 0;
    private bool PodeConfirmar => _formaPagamento != FormaPagamento.Dinheiro || _valorRecebido >= Subtotal;

    protected override void OnInitialized()
    {
        ServicoAtalhos.DefinirTecla("ModalFinalizarVenda.FocarValorRecebido", "F5");
        ServicoAtalhos.DefinirTecla("ModalFinalizarVenda.Concluir", "Enter");
        _atalhos.Add(ServicoAtalhos.Registrar("ModalFinalizarVenda.Concluir", ConfirmarViaAtalhoAsync));

        foreach (var (forma, tecla) in _opcoesFormaPagamento)
        {
            var acaoId = $"ModalFinalizarVenda.{forma}";
            ServicoAtalhos.DefinirTecla(acaoId, tecla);
            _atalhos.Add(ServicoAtalhos.Registrar(acaoId, () =>
            {
                _formaPagamento = forma;
                AtualizarAtalhoValorRecebido();
                StateHasChanged();
                return Task.CompletedTask;
            }));
        }

        AtualizarAtalhoValorRecebido();
    }

    protected override void OnParametersSet()
    {
        if (!_valorInicializado)
        {
            _valorRecebido = Subtotal;
            _valorInicializado = true;
        }
    }

    private void Confirmar()
    {
        if (!PodeConfirmar)
        {
            return;
        }

        var valorRecebido = _formaPagamento == FormaPagamento.Dinheiro ? _valorRecebido : Subtotal;
        MudDialog.Close(DialogResult.Ok(new ResultadoFinalizacaoVenda(_formaPagamento, valorRecebido)));
    }

    private Task ConfirmarViaAtalhoAsync()
    {
        Confirmar();
        return Task.CompletedTask;
    }

    private void Cancelar() => MudDialog.Cancel();

    private void AtualizarAtalhoValorRecebido()
    {
        if (_formaPagamento == FormaPagamento.Dinheiro)
        {
            _atalhoFocarValorRecebido ??= ServicoAtalhos.Registrar(
                "ModalFinalizarVenda.FocarValorRecebido",
                FocarValorRecebidoAsync);
            return;
        }

        _atalhoFocarValorRecebido?.Dispose();
        _atalhoFocarValorRecebido = null;
    }

    private Task FocarValorRecebidoAsync()
    {
        _deveFocarValorRecebido = true;
        StateHasChanged();
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_deveFocarValorRecebido || _formaPagamento != FormaPagamento.Dinheiro)
        {
            return;
        }

        _deveFocarValorRecebido = false;
        await _campoValorRecebido.FocusAsync();
    }

    public void Dispose()
    {
        _atalhoFocarValorRecebido?.Dispose();

        foreach (var atalho in _atalhos)
        {
            atalho.Dispose();
        }
    }

    public record ResultadoFinalizacaoVenda(FormaPagamento FormaPagamento, decimal ValorRecebido);
}
