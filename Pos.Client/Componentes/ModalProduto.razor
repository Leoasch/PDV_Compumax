@inject ServicoProdutos ServicoProdutos
@inject ServicoAtalhos ServicoAtalhos
@implements IDisposable

<MudDialog>
    <TitleContent>@(ProdutoId is null ? "Novo produto" : "Editar produto")</TitleContent>
    <DialogContent>
        @if (_carregando)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else
        {
            <MudForm @ref="_form" Model="_modelo">
                <MudTextField T="string"
                              @bind-Value="_modelo.Codigo"
                              Label="Código"
                              Required="true"
                              RequiredError="Informe o código" />

                <MudTextField T="string"
                              @bind-Value="_modelo.Descricao"
                              Label="Descrição"
                              Required="true"
                              RequiredError="Informe a descrição"
                              Class="mt-4" />

                <MudNumericField T="decimal"
                                  @bind-Value="_modelo.PrecoCusto"
                                  Label="Preço de custo"
                                  Min="0"
                                  Format="F2"
                                  Class="mt-4" />

                <MudNumericField T="decimal"
                                  @bind-Value="_modelo.PrecoVenda"
                                  Label="Preço de venda"
                                  Min="0"
                                  Format="F2"
                                  Class="mt-4" />

                <MudNumericField T="int"
                                  @bind-Value="_modelo.QuantidadeEstoque"
                                  Label="Quantidade em estoque"
                                  Min="0"
                                  Class="mt-4" />

                @if (_erro is not null)
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="mt-4">@_erro</MudAlert>
                }
            </MudForm>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(_carregando || _salvando)" OnClick="SalvarAsync">
            <Atalho Tecla="F2" Descricao="Salvar" />
            @if (_salvando)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public int? ProdutoId { get; set; }

    private MudForm _form = default!;
    private readonly ModeloProduto _modelo = new();
    private readonly List<IDisposable> _atalhos = [];
    private bool _carregando;
    private bool _salvando;
    private string? _erro;

    protected override async Task OnInitializedAsync()
    {
        ServicoAtalhos.DefinirTecla("ModalProduto.Salvar", "F2");
        _atalhos.Add(ServicoAtalhos.Registrar("ModalProduto.Salvar", SalvarViaAtalhoAsync));

        if (ProdutoId is null)
        {
            return;
        }

        _carregando = true;
        try
        {
            var produto = await ServicoProdutos.ObterPorIdAsync(ProdutoId.Value);
            if (produto is not null)
            {
                _modelo.Codigo = produto.Codigo;
                _modelo.Descricao = produto.Descricao;
                _modelo.PrecoCusto = produto.PrecoCusto;
                _modelo.PrecoVenda = produto.PrecoVenda;
                _modelo.QuantidadeEstoque = produto.QuantidadeEstoque;
            }
        }
        finally
        {
            _carregando = false;
        }
    }

    private async Task SalvarViaAtalhoAsync()
    {
        await SalvarAsync();
        StateHasChanged();
    }

    private async Task SalvarAsync()
    {
        if (_carregando || _salvando)
        {
            return;
        }

        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            return;
        }

        _erro = null;
        _salvando = true;

        (bool Sucesso, string? Erro) resultado;
        if (ProdutoId is null)
        {
            resultado = await ServicoProdutos.CriarAsync(new ProdutoRequest(
                _modelo.Codigo, _modelo.Descricao, _modelo.PrecoCusto, _modelo.PrecoVenda, _modelo.QuantidadeEstoque));
        }
        else
        {
            resultado = await ServicoProdutos.EditarAsync(ProdutoId.Value, new ProdutoAtualizacaoRequest(
                _modelo.Codigo,
                _modelo.Descricao,
                _modelo.PrecoCusto,
                _modelo.PrecoVenda,
                _modelo.QuantidadeEstoque));
        }

        _salvando = false;

        if (!resultado.Sucesso)
        {
            _erro = resultado.Erro ?? "Não foi possível salvar o produto.";
            return;
        }

        MudDialog.Close(DialogResult.Ok(true));
    }

    private void Cancelar() => MudDialog.Cancel();

    public void Dispose()
    {
        foreach (var atalho in _atalhos)
        {
            atalho.Dispose();
        }
    }

    private class ModeloProduto
    {
        public string Codigo { get; set; } = string.Empty;
        public string Descricao { get; set; } = string.Empty;
        public decimal PrecoCusto { get; set; }
        public decimal PrecoVenda { get; set; }
        public int QuantidadeEstoque { get; set; }
    }
}
