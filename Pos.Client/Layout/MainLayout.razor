@inherits LayoutComponentBase
@inject ServicoAtalhos ServicoAtalhos
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider ProvedorEstadoAutenticacao
@implements IDisposable

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@(() => _menuAberto = !_menuAberto)" />
        <MudText Typo="Typo.h6">PDV Compumax</MudText>
        <MudSpacer />
    </MudAppBar>

    <MudDrawer @bind-Open="_menuAberto" Elevation="2">
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="my-1">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _menuAberto = true;
    private readonly List<IDisposable> _atalhos = [];
    private bool _ehAdmin;

    protected override async Task OnInitializedAsync()
    {
        ServicoAtalhos.DefinirTecla("AlternarMenu", "F10");
        ServicoAtalhos.DefinirTecla("NavegarCaixa", "F6");
        ServicoAtalhos.DefinirTecla("NavegarVendas", "F7");
        ServicoAtalhos.DefinirTecla("NavegarUsuarios", "F8");
        ServicoAtalhos.DefinirTecla("NavegarProdutos", "F9");

        _atalhos.Add(ServicoAtalhos.Registrar("AlternarMenu", () =>
        {
            _menuAberto = !_menuAberto;
            StateHasChanged();
            return Task.CompletedTask;
        }));

        _atalhos.Add(ServicoAtalhos.Registrar("NavegarCaixa", () => NavegarAsync("/")));
        _atalhos.Add(ServicoAtalhos.Registrar("NavegarVendas", () => NavegarAsync("/dashboard/vendas")));
        _atalhos.Add(ServicoAtalhos.Registrar("NavegarUsuarios", () => NavegarSeAdminAsync("/dashboard/users")));
        _atalhos.Add(ServicoAtalhos.Registrar("NavegarProdutos", () => NavegarSeAdminAsync("/dashboard/produtos")));

        var estadoAutenticacao = await ProvedorEstadoAutenticacao.GetAuthenticationStateAsync();
        _ehAdmin = estadoAutenticacao.User.IsInRole("Admin");
    }

    private Task NavegarAsync(string url)
    {
        NavigationManager.NavigateTo(url);
        return Task.CompletedTask;
    }

    private Task NavegarSeAdminAsync(string url)
    {
        if (_ehAdmin)
        {
            NavigationManager.NavigateTo(url);
        }
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ServicoAtalhos.IniciarCapturaGlobalAsync(JSRuntime);
        }
    }

    public void Dispose()
    {
        foreach (var atalho in _atalhos)
        {
            atalho.Dispose();
        }
    }
}
