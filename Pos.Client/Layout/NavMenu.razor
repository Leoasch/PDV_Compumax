@inject ServicoAutenticacao ServicoAutenticacao
@inject NavigationManager NavigationManager

<MudNavMenu>
    <AuthorizeView>
        <Authorized>
            <MudText Typo="Typo.subtitle2" Class="px-4 py-2" Color="Color.Primary">
                @context.User.FindFirst(ClaimsPersonalizadas.NomeCompleto)?.Value
            </MudText>
            <MudDivider Class="mb-2" />
        </Authorized>
    </AuthorizeView>

    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Início</MudNavLink>
    <MudNavLink Href="counter" Icon="@Icons.Material.Filled.Add">Counter</MudNavLink>

    <AuthorizeView>
        <Authorized>
            <MudDivider Class="my-2" />
            <MudNavLink OnClick="SairAsync" Icon="@Icons.Material.Filled.Logout">Sair</MudNavLink>
        </Authorized>
    </AuthorizeView>
</MudNavMenu>

@code {
    private async Task SairAsync()
    {
        await ServicoAutenticacao.SairAsync();
        NavigationManager.NavigateTo("/login");
    }
}
