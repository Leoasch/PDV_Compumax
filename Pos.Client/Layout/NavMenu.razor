@inject ServicoAutenticacao ServicoAutenticacao
@inject ServicoAtalhos ServicoAtalhos
@inject NavigationManager NavigationManager

<MudNavMenu Style="display:flex; flex-direction:column; height:100%;">
    <AuthorizeView>
        <Authorized>
            <MudText Typo="Typo.h6" Class="px-4 py-2" Color="Color.Primary" >
                @context.User.FindFirst(ClaimsPersonalizadas.NomeCompleto)?.Value
            </MudText>
            <MudDivider Class="mb-2" Style="flex-grow:0;" />
            
        </Authorized>
    </AuthorizeView>

    <AuthorizeView>
        <Authorized>
            <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.PointOfSale">
                <div class="d-flex align-center justify-space-between">
                    Caixa
                    <Atalho Tecla="F6" />
                </div>
            </MudNavLink>
            <MudNavLink Href="dashboard/vendas" Icon="@Icons.Material.Filled.ReceiptLong">
                <div class="d-flex align-center justify-space-between">
                    Vendas
                    <Atalho Tecla="F7" />
                </div>
            </MudNavLink>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="Admin">
        <Authorized>
            <MudNavLink Href="dashboard/users" Icon="@Icons.Material.Filled.ManageAccounts">
                <div class="d-flex align-center justify-space-between">
                    Usuários
                    <Atalho Tecla="F8" />
                </div>
            </MudNavLink>
            <MudNavLink Href="dashboard/produtos" Icon="@Icons.Material.Filled.Inventory2">
                <div class="d-flex align-center justify-space-between">
                    Produtos
                    <Atalho Tecla="F9" />
                </div>
            </MudNavLink>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView>
        <Authorized>
            <div style="margin-top:auto;">
                <MudDivider Class="mb-2" />
                <MudNavLink OnClick="SairAsync" Icon="@Icons.Material.Filled.Logout">
                    <div class="d-flex align-center justify-space-between">
                        Sair
                        <Atalho Tecla="Ctrl+Shift+L" />
                    </div>
                </MudNavLink>
            </div>
        </Authorized>
    </AuthorizeView>
</MudNavMenu>

@code {
    private async Task SairAsync()
    {
        await ServicoAutenticacao.SairAsync();
        NavigationManager.NavigateTo("/login");
    }
}
