@page "/counter"
@attribute [Authorize]
@inject ServicoAtalhos ServicoAtalhos
@implements IDisposable

<PageTitle>Counter</PageTitle>

<h1>Counter</h1>

<p role="status">Current count: @currentCount</p>

<button class="btn btn-primary" @onclick="IncrementCount">
    Click me <kbd>@ServicoAtalhos.ObterTecla("IncrementarContador")</kbd>
</button>

@code {
    private int currentCount = 0;
    private IDisposable? _atalhoIncrementar;

    protected override void OnInitialized()
    {
        ServicoAtalhos.DefinirTecla("IncrementarContador", "F4");
        _atalhoIncrementar = ServicoAtalhos.Registrar("IncrementarContador", () =>
        {
            IncrementCount();
            StateHasChanged();
            return Task.CompletedTask;
        });
    }

    private void IncrementCount()
    {
        currentCount++;
    }

    public void Dispose()
    {
        _atalhoIncrementar?.Dispose();
    }
}
