@page "/"
@page "/dashboard/caixa"
@attribute [Authorize]
@inject ServicoAtalhos ServicoAtalhos
@inject ServicoVendas ServicoVendas
@inject ArmazenamentoCarrinho ArmazenamentoCarrinho
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@implements IDisposable

<PageTitle>Caixa</PageTitle>

<div @ref="_focoNeutro" tabindex="-1" style="position:absolute; width:0; height:0; overflow:hidden; outline:none;"></div>

<MudGrid Spacing="3">
    <MudItem xs="12">
        <MudButton StartIcon="@Icons.Material.Filled.Add"
                   Color="Color.Primary"
                   Variant="Variant.Filled"
                   Size="Size.Large"
                   FullWidth="true"
                   OnClick="AbrirModalAdicionarProdutoAsync">
            Adicionar produto
        </MudButton>
    </MudItem>

    <MudItem xs="12" md="4">
        <MudPaper Class="pa-4" Elevation="1" Style="max-height: calc(100vh - 156px); overflow-y: auto;">
            <MudPaper Outlined="true" Class="d-flex align-center justify-center mb-3" Style="height:140px;">
                @if (_produtoAtual is not null)
                {
                    <MudText Align="Align.Center">@_produtoAtual.Descricao</MudText>
                }
                else
                {
                    <MudText Color="Color.Secondary">Nenhum produto selecionado</MudText>
                }
            </MudPaper>

            <MudTextField T="string" Label="Código" Value="@(_produtoAtual?.Codigo ?? string.Empty)" ReadOnly="true" Class="mb-3" />

            <MudPaper Outlined="true" Class="pa-3 mb-3">
                <MudText Typo="Typo.caption">Valor unitário</MudText>
                <MudText Typo="Typo.h5">@((_produtoAtual?.PrecoVenda ?? 0).ToString("C2"))</MudText>
            </MudPaper>

            <MudPaper Outlined="true" Class="pa-3 mb-3">
                <MudText Typo="Typo.caption">Total do último item</MudText>
                <MudText Typo="Typo.h5">@(((_produtoAtual?.PrecoVenda ?? 0) * _ultimaQuantidadeAdicionada).ToString("C2"))</MudText>
            </MudPaper>

            <MudPaper Outlined="true" Class="pa-3">
                <MudText Typo="Typo.subtitle2" Class="mb-2">Atalhos</MudText>
                @foreach (var atalho in _legendaAtalhos)
                {
                    <div class="mb-1">
                        <Atalho Tecla="@atalho.Tecla" Descricao="@atalho.Descricao" />
                    </div>
                }
            </MudPaper>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="8" Style="max-height: calc(100vh - 156px); overflow-y: auto;">
        <MudPaper Class="pa-0 mb-3" Elevation="1">
            <MudText Typo="Typo.subtitle1" Class="pa-3">Itens da venda</MudText>
            <MudTable Items="@_itens" Hover="true" Dense="true" FixedHeader="true" Height="45vh">
                <HeaderContent>
                    <MudTh>Item</MudTh>
                    <MudTh>Código</MudTh>
                    <MudTh>Descrição</MudTh>
                    <MudTh>Qtd</MudTh>
                    <MudTh>Vlr. Unit.</MudTh>
                    <MudTh>Total</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@(_itens.IndexOf(context) + 1)</MudTd>
                    <MudTd>@context.ProdutoCodigo</MudTd>
                    <MudTd>@context.ProdutoDescricao</MudTd>
                    <MudTd>@context.Quantidade</MudTd>
                    <MudTd>@context.PrecoUnitario.ToString("C2")</MudTd>
                    <MudTd>@context.Subtotal.ToString("C2")</MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Color="Color.Secondary">Nenhum item adicionado ainda.</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>

        <MudPaper Class="pa-3 mb-3" Elevation="1">
            <MudText Typo="Typo.subtitle2">Subtotal</MudText>
            <MudText Typo="Typo.h4">@_subtotal.ToString("C2")</MudText>
        </MudPaper>

        <MudGrid Spacing="3">
            <MudItem xs="6">
                <MudPaper Class="pa-3" Elevation="1">
                    <MudText Typo="Typo.caption">Total recebido</MudText>
                    <MudText Typo="Typo.h5">@_totalRecebido.ToString("C2")</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="6">
                <MudPaper Class="pa-3" Elevation="1">
                    <MudText Typo="Typo.caption">Troco</MudText>
                    <MudText Typo="Typo.h5">@_troco.ToString("C2")</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudGrid Spacing="3" Class="mt-2">
            <MudItem xs="6">
                <MudButton StartIcon="@Icons.Material.Filled.CheckCircle"
                           Color="Color.Success"
                           Variant="Variant.Filled"
                           Size="Size.Large"
                           FullWidth="true"
                           OnClick="FinalizarVendaAsync">
                    Finalizar venda
                </MudButton>
            </MudItem>
            <MudItem xs="6">
                <MudButton StartIcon="@Icons.Material.Filled.Cancel"
                           Color="Color.Error"
                           Variant="Variant.Outlined"
                           Size="Size.Large"
                           FullWidth="true"
                           OnClick="CancelarVendaAtualAsync">
                    Cancelar venda
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudItem>
</MudGrid>

@code {
    private readonly List<IDisposable> _atalhos = [];
    private ElementReference _focoNeutro;

    private ProdutoDto? _produtoAtual;
    private int _ultimaQuantidadeAdicionada;
    private IDialogReference? _dialogoAdicionarProduto;
    private decimal _subtotal;
    private decimal _totalRecebido;
    private decimal _troco;

    private readonly List<ItemVendaDto> _itens = [];

    private readonly List<(string Tecla, string Descricao)> _legendaAtalhos =
    [
        ("F4", "Adicionar produto"),
        ("F7", "Remover item"),
        ("F8", "Nova venda"),
        ("F9", "Buscar venda"),
        ("F10", "Finalizar venda"),
        ("F11", "Cancelar venda"),
    ];

    protected override async Task OnInitializedAsync()
    {
        ServicoAtalhos.DefinirTecla("PdvBuscarProduto", "F4");
        ServicoAtalhos.DefinirTecla("PdvRemoverItem", "F7");
        ServicoAtalhos.DefinirTecla("PdvNovaVenda", "F8");
        ServicoAtalhos.DefinirTecla("PdvBuscarVenda", "F9");
        ServicoAtalhos.DefinirTecla("PdvFinalizarVenda", "F10");
        ServicoAtalhos.DefinirTecla("PdvCancelarVenda", "F11");

        _atalhos.Add(ServicoAtalhos.Registrar("PdvBuscarProduto", AbrirModalAdicionarProdutoAsync));
        _atalhos.Add(ServicoAtalhos.Registrar("PdvRemoverItem", RemoverUltimoItemAsync));
        _atalhos.Add(ServicoAtalhos.Registrar("PdvNovaVenda", NovaVendaAsync));
        _atalhos.Add(ServicoAtalhos.Registrar("PdvBuscarVenda", () =>
        {
            Snackbar.Add("Consulta de vendas ainda não implementada.", Severity.Info);
            return Task.CompletedTask;
        }));
        _atalhos.Add(ServicoAtalhos.Registrar("PdvFinalizarVenda", FinalizarVendaAsync));
        _atalhos.Add(ServicoAtalhos.Registrar("PdvCancelarVenda", CancelarVendaAtualAsync));

        var itensSalvos = await ArmazenamentoCarrinho.ObterAsync();
        if (itensSalvos.Count > 0)
        {
            _itens.AddRange(itensSalvos);
            AtualizarSubtotal();
        }
    }

    private async Task AbrirModalAdicionarProdutoAsync()
    {
        if (_dialogoAdicionarProduto is not null)
        {
            _dialogoAdicionarProduto.Close();
            return;
        }

        var opcoes = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, DefaultFocus = DefaultFocus.FirstChild };
        var dialogo = await DialogService.ShowAsync<ModalAdicionarProduto>(null, opcoes);
        _dialogoAdicionarProduto = dialogo;

        var resultado = await dialogo.Result;
        _dialogoAdicionarProduto = null;

        await Task.Delay(80);
        await _focoNeutro.FocusAsync();

        if (resultado is null || resultado.Canceled || resultado.Data is not ModalAdicionarProduto.ResultadoAdicaoProduto dados)
        {
            return;
        }

        AdicionarItem(dados.Produto, dados.Quantidade);
        await ArmazenamentoCarrinho.SalvarAsync(_itens);

        _produtoAtual = dados.Produto;
        _ultimaQuantidadeAdicionada = dados.Quantidade;

        StateHasChanged();
    }

    private void AdicionarItem(ProdutoDto produto, int quantidade)
    {
        if (_itens.Count == 0)
        {
            _totalRecebido = 0;
            _troco = 0;
        }

        var estoqueRestante = produto.QuantidadeEstoque - QuantidadeJaNoCarrinho(produto.Id);
        if (quantidade > estoqueRestante)
        {
            Snackbar.Add($"Estoque insuficiente para '{produto.Descricao}' — o estoque ficará negativo.", Severity.Warning);
        }

        var existente = _itens.FirstOrDefault(i => i.ProdutoId == produto.Id);
        if (existente is not null)
        {
            var novaQuantidade = existente.Quantidade + quantidade;
            var index = _itens.IndexOf(existente);
            _itens[index] = existente with { Quantidade = novaQuantidade, Subtotal = novaQuantidade * existente.PrecoUnitario };
        }
        else
        {
            _itens.Add(new ItemVendaDto(produto.Id, produto.Codigo, produto.Descricao, quantidade, produto.PrecoVenda, quantidade * produto.PrecoVenda));
        }

        AtualizarSubtotal();
    }

    private int QuantidadeJaNoCarrinho(int produtoId) => _itens.FirstOrDefault(i => i.ProdutoId == produtoId)?.Quantidade ?? 0;

    private void AtualizarSubtotal() => _subtotal = _itens.Sum(i => i.Subtotal);

    private async Task RemoverUltimoItemAsync()
    {
        if (_itens.Count == 0)
        {
            Snackbar.Add("Não há itens para remover.", Severity.Info);
            return;
        }

        _itens.RemoveAt(_itens.Count - 1);
        AtualizarSubtotal();
        await ArmazenamentoCarrinho.SalvarAsync(_itens);
        StateHasChanged();
    }

    private async Task NovaVendaAsync()
    {
        await LimparCarrinhoAsync();
        Snackbar.Add("Nova venda iniciada.", Severity.Info);
        StateHasChanged();
    }

    private async Task CancelarVendaAtualAsync()
    {
        if (_itens.Count == 0)
        {
            Snackbar.Add("Não há venda em andamento para cancelar.", Severity.Info);
            return;
        }

        var confirmado = await DialogService.ShowMessageBoxAsync(
            "Cancelar venda",
            "Deseja cancelar a venda atual? Os itens adicionados serão perdidos.",
            yesText: "Cancelar venda",
            cancelText: "Voltar");

        if (confirmado == true)
        {
            await LimparCarrinhoAsync();
            Snackbar.Add("Venda cancelada.", Severity.Info);
        }

        await _focoNeutro.FocusAsync();
        StateHasChanged();
    }

    private async Task FinalizarVendaAsync()
    {
        if (_itens.Count == 0)
        {
            Snackbar.Add("Adicione itens antes de finalizar a venda.", Severity.Warning);
            return;
        }

        var parametros = new DialogParameters { { nameof(ModalFinalizarVenda.Subtotal), _subtotal } };
        var opcoes = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialogo = await DialogService.ShowAsync<ModalFinalizarVenda>(null, parametros, opcoes);
        var resultado = await dialogo.Result;

        if (resultado is null || resultado.Canceled || resultado.Data is not ModalFinalizarVenda.ResultadoFinalizacaoVenda dados)
        {
            return;
        }

        var request = new VendaRequest(
            _itens.Select(i => new ItemVendaRequest(i.ProdutoId!.Value, i.Quantidade)).ToList(),
            dados.FormaPagamento);

        var (sucesso, venda, erro) = await ServicoVendas.CriarAsync(request);

        if (!sucesso || venda is null)
        {
            Snackbar.Add(erro ?? "Não foi possível finalizar a venda.", Severity.Error);
            return;
        }

        _totalRecebido = dados.ValorRecebido;
        _troco = dados.ValorRecebido - venda.Total;

        _itens.Clear();
        _subtotal = 0;
        _produtoAtual = null;
        _ultimaQuantidadeAdicionada = 0;
        await ArmazenamentoCarrinho.LimparAsync();

        Snackbar.Add($"Venda #{venda.Id} finalizada com sucesso.", Severity.Success);
        await _focoNeutro.FocusAsync();
        StateHasChanged();
    }

    private async Task LimparCarrinhoAsync()
    {
        _itens.Clear();
        _subtotal = 0;
        _totalRecebido = 0;
        _troco = 0;
        _produtoAtual = null;
        _ultimaQuantidadeAdicionada = 0;
        await ArmazenamentoCarrinho.LimparAsync();
    }

    public void Dispose()
    {
        foreach (var atalho in _atalhos)
        {
            atalho.Dispose();
        }
    }
}
