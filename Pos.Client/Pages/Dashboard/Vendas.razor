@page "/dashboard/vendas"
@attribute [Authorize]
@inject ServicoVendas ServicoVendas
@inject ServicoAtalhos ServicoAtalhos
@inject IDialogService DialogService
@implements IDisposable

<PageTitle>Vendas</PageTitle>

<h1>Vendas</h1>

<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="4" Class="mb-2">
  <Atalho Tecla="F1" Descricao="Buscar" />
  <Atalho Tecla="F5" Descricao="Atualizar" />
  <Atalho Tecla="↑↓" Descricao="Navegar" />
  <Atalho Tecla="Enter" Descricao="Abrir venda" />
</MudStack>

<MudTextField T="string"
              @ref="_campoBusca"
              @bind-Value="_termoBusca"
              Immediate="true"
              AutoFocus="true"
              Placeholder="Buscar por usuário ou forma de pagamento..."
              Adornment="Adornment.Start"
              AdornmentIcon="@Icons.Material.Filled.Search"
              Class="mb-4" />

<MudTable @ref="_tabela" Items="@_vendas" Hover="true" Loading="@_carregando" RowsPerPage="10" Filter="new Func<VendaResumoDto, bool>(FiltrarVenda)"
          @bind-SelectedItem="_vendaSelecionada"
          RowClassFunc="@((venda, _) => venda.Id == _vendaSelecionada?.Id ? "linha-selecionada-teclado" : string.Empty)"
          Height="calc(100vh - 290px)" FixedHeader="true">
  <HeaderContent>
    <MudTh>Nº</MudTh>
    <MudTh>Data/Hora</MudTh>
    <MudTh>Usuário</MudTh>
    <MudTh>Forma de pagamento</MudTh>
    <MudTh>Total</MudTh>
    <MudTh>Status</MudTh>
    <MudTh></MudTh>
  </HeaderContent>
  <RowTemplate>
    <MudTd>@context.Id</MudTd>
    <MudTd>@context.DataHora.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</MudTd>
    <MudTd><MudHighlighter Text="@context.UsuarioNomeCompleto" HighlightedText="@_termoBusca" /></MudTd>
    <MudTd><MudHighlighter Text="@context.FormaPagamento.ObterLabel()" HighlightedText="@_termoBusca" /></MudTd>
    <MudTd>@context.Total.ToString("C2")</MudTd>
    <MudTd>
      <MudChip T="string" Color="@(context.Cancelada ? Color.Error : Color.Success)" Size="Size.Small">
        @(context.Cancelada ? "Cancelada" : "Concluída")
      </MudChip>
    </MudTd>
    <MudTd>
      <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" OnClick="@(() => AbrirDetalhesAsync(context.Id))" />
    </MudTd>
  </RowTemplate>
  <PagerContent>
    <MudTablePager PageSizeOptions="new[] { 10, 25, 50, 100 }" />
  </PagerContent>
</MudTable>

@code {
  private readonly List<IDisposable> _atalhos = [];
  private readonly List<IDisposable> _atalhosNavegacao = [];
  private MudTextField<string> _campoBusca = default!;
  private MudTable<VendaResumoDto> _tabela = default!;
  private IDialogReference? _dialogoDetalhes;
  private VendaResumoDto? _vendaSelecionada;

  private bool _carregando = true;
  private List<VendaResumoDto> _vendas = [];
  private string _termoBusca = string.Empty;

  private bool FiltrarVenda(VendaResumoDto venda)
  {
    if (string.IsNullOrWhiteSpace(_termoBusca))
    {
      return true;
    }

    return venda.UsuarioNomeCompleto.Contains(_termoBusca, StringComparison.OrdinalIgnoreCase)
        || venda.FormaPagamento.ObterLabel().Contains(_termoBusca, StringComparison.OrdinalIgnoreCase);
  }

  protected override async Task OnInitializedAsync()
  {
    ServicoAtalhos.DefinirTecla("VendasBuscar", "F1");
    ServicoAtalhos.DefinirTecla("VendasAtualizar", "F5");
    ServicoAtalhos.DefinirTecla("VendasNavegarCima", "ArrowUp");
    ServicoAtalhos.DefinirTecla("VendasNavegarBaixo", "ArrowDown");
    ServicoAtalhos.DefinirTecla("VendasAbrirSelecionado", "Enter");

    _atalhos.Add(ServicoAtalhos.Registrar("VendasBuscar", FocarBuscaAsync));
    _atalhos.Add(ServicoAtalhos.Registrar("VendasAtualizar", AtualizarViaAtalhoAsync));
    RegistrarNavegacao();

    await CarregarVendasAsync();
  }

  private void RegistrarNavegacao()
  {
    _atalhosNavegacao.Add(ServicoAtalhos.Registrar("VendasNavegarCima", NavegarCimaAsync));
    _atalhosNavegacao.Add(ServicoAtalhos.Registrar("VendasNavegarBaixo", NavegarBaixoAsync));
    _atalhosNavegacao.Add(ServicoAtalhos.Registrar("VendasAbrirSelecionado", AbrirSelecionadoAsync));
  }

  private void DesregistrarNavegacao()
  {
    foreach (var atalho in _atalhosNavegacao)
    {
      atalho.Dispose();
    }

    _atalhosNavegacao.Clear();
  }

  private async Task AtualizarViaAtalhoAsync()
  {
    await CarregarVendasAsync();
    StateHasChanged();
  }

  private async Task CarregarVendasAsync()
  {
    _carregando = true;
    _vendaSelecionada = null;
    try
    {
      _vendas = await ServicoVendas.ListarAsync();
    }
    finally
    {
      _carregando = false;
    }
  }

  private Task NavegarCimaAsync()
  {
    MoverSelecao(-1);
    StateHasChanged();
    return Task.CompletedTask;
  }

  private Task NavegarBaixoAsync()
  {
    MoverSelecao(1);
    StateHasChanged();
    return Task.CompletedTask;
  }

  private async Task AbrirSelecionadoAsync()
  {
    if (_vendaSelecionada is null)
    {
      return;
    }

    await AbrirDetalhesAsync(_vendaSelecionada.Id);
  }

  private void MoverSelecao(int delta)
  {
    var itens = _tabela.FilteredItems.ToList();
    if (itens.Count == 0)
    {
      return;
    }

    var indiceAtual = _vendaSelecionada is null ? -1 : itens.FindIndex(v => v.Id == _vendaSelecionada.Id);
    var novoIndice = Math.Clamp(indiceAtual + delta, 0, itens.Count - 1);
    _vendaSelecionada = itens[novoIndice];

    var novaPagina = novoIndice / _tabela.RowsPerPage;
    if (novaPagina != _tabela.CurrentPage)
    {
      _tabela.NavigateTo(novaPagina);
    }
  }

  private async Task FocarBuscaAsync()
  {
    if (_dialogoDetalhes is not null)
    {
      return;
    }

    await _campoBusca.FocusAsync();
  }

  private async Task AbrirDetalhesAsync(int vendaId)
  {
    var parametros = new DialogParameters { { nameof(ModalDetalhesVenda.VendaId), vendaId } };
    var opcoes = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };

    DesregistrarNavegacao();
    var dialogo = await DialogService.ShowAsync<ModalDetalhesVenda>(null, parametros, opcoes);
    _dialogoDetalhes = dialogo;

    await dialogo.Result;
    _dialogoDetalhes = null;
    RegistrarNavegacao();
  }

  public void Dispose()
  {
    foreach (var atalho in _atalhos)
    {
      atalho.Dispose();
    }

    DesregistrarNavegacao();
  }
}
